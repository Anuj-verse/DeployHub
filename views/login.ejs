<%- include('partials/head', { title: title }) %>
<div class="login-page">

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <div class="hero">
    <!-- Left column -->
    <div class="hero-left">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        Automated Container Pipeline
      </div>

      <h1 class="hero-headline">
        Push code. Ship to Kubernetes without the <em>YAML.</em>
      </h1>

      <p class="hero-body">
        DeploySync connects your GitHub repositories, automatically detects runtime dependencies, generates multi-stage container builds, and deploys scalable pods to your cluster with live streaming logs.
      </p>

      <% if (error) { %>
        <div class="banner banner-error"><%= error %></div>
      <% } %>

      <div class="hero-ctas">
        <a class="btn btn-primary btn-lg" href="/auth/github">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          Continue with GitHub
        </a>
        <a class="btn btn-secondary btn-lg" href="#pipeline">View Architecture</a>
      </div>

      <div class="hero-proof">
        <div class="hero-proof-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Zero-config runtime detection
        </div>
        <div class="hero-proof-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Docker and K8s automation
        </div>
        <div class="hero-proof-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Auto-redeploy on webhook push
        </div>
      </div>
    </div>

    <!-- Right column – mock terminal -->
    <div class="hero-right">
      <div class="terminal-window">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="tl-red"></span>
            <span class="tl-yellow"></span>
            <span class="tl-green"></span>
          </div>
          <span class="terminal-title">deploysync-pipeline · octocat/web-service:main (a1f89bc)</span>
          <span class="terminal-live-badge">LIVE</span>
        </div>
        <div class="pipeline-row">
          <div class="pipe-step"><div class="pipe-dot">✓</div> Clone</div>
          <div class="pipe-connector"></div>
          <div class="pipe-step"><div class="pipe-dot">✓</div> Detect</div>
          <div class="pipe-connector"></div>
          <div class="pipe-step"><div class="pipe-dot">✓</div> Generate</div>
          <div class="pipe-connector"></div>
          <div class="pipe-step"><div class="pipe-dot">✓</div> Build</div>
          <div class="pipe-connector"></div>
          <div class="pipe-step"><div class="pipe-dot">✓</div> Deploy</div>
        </div>
        <div class="terminal-body">
          <div class="tl stage"><span class="ts">19:16:02</span><span class="msg">▶ Phase 1: Repository inspection</span></div>
          <div class="tl cmd">  <span class="ts">19:16:03</span><span class="msg">$ git clone https://github.com/octocat/web-service</span></div>
          <div class="tl ok">   <span class="ts">19:16:04</span><span class="msg">✔ Detected stack: Node.js 20 LTS (container port 3000)</span></div>
          <div class="tl stage"><span class="ts">19:16:05</span><span class="msg">▶ Phase 2: Container image generation</span></div>
          <div class="tl cmd">  <span class="ts">19:16:06</span><span class="msg">$ docker build -t deploysync/web-service:a1f89bc .</span></div>
          <div class="tl ok">   <span class="ts">19:16:08</span><span class="msg">✔ Image pushed to registry (digest: sha256:7e9a2b…)</span></div>
          <div class="tl stage"><span class="ts">19:16:09</span><span class="msg">▶ Phase 3: Kubernetes deployment rollout</span></div>
          <div class="tl cmd">  <span class="ts">19:16:10</span><span class="msg">$ kubectl apply -f manifest.yaml</span></div>
          <div class="tl ok">   <span class="ts">19:16:11</span><span class="msg">✔ Deployment healthy: 2/2 pods running at http://localhost:3000</span></div>
        </div>
      </div>

      <div class="terminal-stat-card">
        <div class="stat-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="stat-body">
          <div class="stat-title">Cluster Rollout Successful</div>
          <div class="stat-sub">Ingress route active · 0s downtime &nbsp;·&nbsp; Replicas: 2/2 Ready</div>
        </div>
      </div>
    </div>
  </div>

  <hr class="section-sep">

  <!-- ── How it works ──────────────────────────────────────────────── -->
  <section id="pipeline" class="section">
    <p class="section-label">How it works</p>
    <h2 class="section-heading">
      How DeploySync works.&nbsp;
      <span class="accent">Three steps from git push to cluster pod.</span>
    </h2>

    <div class="feature-grid">
      <!-- Card 1 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2"/></svg>
        </div>
        <div>
          <div class="feature-num">1.</div>
          <div class="feature-title">Instant Stack Detection</div>
        </div>
        <p class="feature-desc">Clones your repository and inspects package files, language markers, and directory structure to identify the runtime automatically — no configuration required.</p>
        <div class="feature-tags">
          <span class="feature-tag">Node.js 20</span>
          <span class="feature-tag">Python 3.12</span>
          <span class="feature-tag">Static Nginx</span>
          <span class="feature-tag">Custom Dockerfile</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
        </div>
        <div>
          <div class="feature-num">2.</div>
          <div class="feature-title">Isolated Container Builds</div>
        </div>
        <p class="feature-desc">Generates an optimised multi-stage Dockerfile, runs the build on the Docker daemon, tags the image with the commit SHA, and pushes to your registry.</p>
        <div class="feature-tags">
          <span class="feature-tag">Multi-Stage</span>
          <span class="feature-tag">SHA Tagging</span>
          <span class="feature-tag">Docker Daemon</span>
          <span class="feature-tag">Zero Bloat</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
        </div>
        <div>
          <div class="feature-num">3.</div>
          <div class="feature-title">Rolling Kubernetes Deploy</div>
        </div>
        <p class="feature-desc">Renders a Kubernetes manifest with your chosen replica count and applies it to the cluster using a rolling update — zero downtime, live pod logs streamed in real time.</p>
        <div class="feature-tags">
          <span class="feature-tag">k8s Deployments</span>
          <span class="feature-tag">ClusterIP Services</span>
          <span class="feature-tag">Live Pod Logs</span>
          <span class="feature-tag">Zero Downtime</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-sep">

  <!-- ── Supported stacks ───────────────────────────────────────────── -->
  <section id="samples" class="section">
    <p class="section-label">Sample applications</p>
    <h2 class="section-heading">
      Works with your everyday stack.&nbsp;
      <span class="accent">Included sample applications ready to deploy.</span>
    </h2>

    <div class="sample-grid">
      <!-- Node.js -->
      <div class="sample-card">
        <div class="sample-header">
          <span class="sample-dot" style="background:#f1e05a"></span>
          <span class="sample-title">Node.js Express API</span>
        </div>
        <p class="sample-desc">A minimal Express server detected by <code>package.json</code>. DeploySync installs dependencies in a build stage and serves from a slim runtime image.</p>
        <div class="code-block"><span style="color:#5ab4fc">const</span> express = require(<span style="color:#a5d6ff">'express'</span>);<br>
<span style="color:#5ab4fc">const</span> app = express();<br>
app.get(<span style="color:#a5d6ff">'/'</span>, (req, res) =&gt; res.send(<span style="color:#a5d6ff">'Hello from K8s'</span>));<br>
app.listen(<span style="color:#3fb950">3000</span>);</div>
      </div>

      <!-- Python -->
      <div class="sample-card">
        <div class="sample-header">
          <span class="sample-dot" style="background:#3572a5"></span>
          <span class="sample-title">Python Flask App</span>
        </div>
        <p class="sample-desc">Detected via <code>requirements.txt</code> containing Flask. A Gunicorn production server is configured automatically in the generated Dockerfile.</p>
        <div class="code-block"><span style="color:#5ab4fc">from</span> flask <span style="color:#5ab4fc">import</span> Flask<br>
app = Flask(__name__)<br><br>
@app.route(<span style="color:#a5d6ff">'/'</span>)<br>
<span style="color:#5ab4fc">def</span> <span style="color:#3fb950">index</span>():<br>
&nbsp;&nbsp;<span style="color:#5ab4fc">return</span> <span style="color:#a5d6ff">'Hello from Flask'</span></div>
      </div>

      <!-- Static -->
      <div class="sample-card">
        <div class="sample-header">
          <span class="sample-dot" style="background:#e34c26"></span>
          <span class="sample-title">Static Web / SPA</span>
        </div>
        <p class="sample-desc">Any repository whose root contains an <code>index.html</code> is served by an optimised Nginx image — no build step, instant deployment.</p>
        <div class="code-block"><span style="color:#7a8599">&lt;!-- index.html --&gt;</span><br>
<span style="color:#5ab4fc">&lt;!DOCTYPE html&gt;</span><br>
<span style="color:#89d0f7">&lt;html&gt;&lt;body&gt;</span><br>
&nbsp;&nbsp;<span style="color:#89d0f7">&lt;h1&gt;</span><span style="color:#a5d6ff">Hello from Nginx</span><span style="color:#89d0f7">&lt;/h1&gt;</span><br>
<span style="color:#89d0f7">&lt;/body&gt;&lt;/html&gt;</span></div>
      </div>
    </div>
  </section>

  <hr class="section-sep">

  <!-- ── CTA ───────────────────────────────────────────────────────── -->
  <div class="cta-section">
    <div class="cta-box">
      <h2>Connect your GitHub and deploy to your cluster.</h2>
      <p>Authenticate once and DeploySync takes care of every container build, registry push, and Kubernetes rollout automatically.</p>
      <a class="btn btn-primary btn-lg" href="/auth/github">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        Start with GitHub
      </a>
    </div>
  </div>

  <!-- ── Footer ────────────────────────────────────────────────────── -->
  <footer class="login-footer">
    <div><strong>DeploySync</strong> &nbsp;·&nbsp; Automated Kubernetes CI/CD Pipeline</div>
    <div>Local Development Mode · Node.js 20+</div>
  </footer>

</div>
